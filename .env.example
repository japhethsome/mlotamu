PORT=5000
CLIENT_URL=http://localhost:5173
# Frontend API endpoint (required on Vercel deployment, e.g. https://your-backend.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# Auth
JWT_SECRET=change-me-to-a-secure-secret
JWT_REFRESH_SECRET=change-me-to-a-secure-refresh-secret
SESSION_SECRET=change-me

# Database
DB_PATH=./data/cafeteria.db

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=demo@example.com
SMTP_PASS=demo-password
EMAIL_FROM="Cafeteria Orders <no-reply@example.com>"

# App settings
BASE_CURRENCY=KES
TAX_RATE=0.10
APP_NAME=Savori Cafeteria
PREFERRED_TIMEZONE=Africa/Nairobi

# Payment — set MOCK_PAYMENT=false to enable real payment processing
MOCK_PAYMENT=true

# ── M-Pesa (Daraja API) ──────────────────────────────────────────────────────
# Get your credentials from https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key-here
MPESA_CONSUMER_SECRET=your-consumer-secret-here
MPESA_SHORTCODE=174379
# Sandbox passkey (replace with production passkey for live):
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public HTTPS URL Safaricom will POST the STK callback to:
MPESA_CALLBACK_URL=https://your-backend.onrender.com/api/payments/mpesa/callback
